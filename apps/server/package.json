{
  "name": "@rtc/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "node init && tsup",
    "start": "node init && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "seed:reset": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts --reset",
    "seed:if-empty": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts --if-empty"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@rtc/crypto": "workspace:*",
    "@rtc/shared": "workspace:*",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.9",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "pino-pretty": "^13.1.3"
  }
}
