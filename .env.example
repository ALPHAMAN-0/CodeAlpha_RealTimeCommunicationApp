# Copy to .env, then run `pnpm setup` to fill in real generated secrets.
# Nothing here is a working value: every CHANGE_ME is rejected at boot in
# production, and no secret has a fallback default anywhere in the code.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

MONGO_URI=mongodb://localhost:27017/rtc
# Host port for the Docker MongoDB. Change this (and the port in
# MONGO_URI above) if another project already has 27017 bound.
MONGO_HOST_PORT=27017

# The origin the browser loads. Single-origin is the supported deployment:
# it is what makes __Host- cookies, SameSite=Strict and a 'self'-only CSP work.
APP_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# strict for single-origin. A split deploy (SPA and API on different hosts)
# needs `none`, which requires https and, in Chrome, partitioned cookies.
COOKIE_SAMESITE=strict
# Reverse-proxy hops to trust for the client IP. Never guess high: trusting an
# untrusted X-Forwarded-For lets a caller forge the key every rate limit uses.
TRUST_PROXY=0

# Ed25519 keypair for access tokens, as base64-encoded PEM.
# Generate both with: pnpm setup
JWT_PRIVATE_KEY_B64=CHANGE_ME
JWT_PUBLIC_KEY_B64=CHANGE_ME
JWT_KID=k1

# 32 bytes of base64 each: openssl rand -base64 32
CSRF_KEY=CHANGE_ME
PASSWORD_PEPPER=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME
BLIND_INDEX_KEY=CHANGE_ME
IP_HASH_KEY=CHANGE_ME
ENUM_KEY=CHANGE_ME

ACCESS_TOKEN_TTL_S=600
REFRESH_TOKEN_TTL_S=1209600
REFRESH_ABSOLUTE_TTL_S=2592000

MAX_UPLOAD_BYTES=26214400
# Mesh hard cap. Uplink scales with (n-1); 4 is ~3.6 Mbps up per client.
MAX_CALL_PARTICIPANTS=4

# Optional TURN relay (`docker compose --profile turn up`). There is no default
# secret: the relay refuses to start without one, and both the relay and the
# API reject anything shorter than 16 characters. Generate one with:
#   openssl rand -base64 32
# TURN_HOST=turn.example.com
# TURN_STATIC_AUTH_SECRET=CHANGE_ME
TURN_TTL_S=300

SERVE_STATIC=false
WEB_DIST_DIR=../web/dist

# Integration tests and repeated local smoke runs only; refused in production.
RATE_LIMIT_DISABLED=false

SEED_PASSWORD=demo1234
DEMO_MODE=true
